{
	"manifest_version": 3,
	"name": "WPGP Tools for Japanese (YamabikoLab)",
	"version": "2.2.0",
	"description": "YamabikoLab fork of WPGP Tools with checks for Japanese WordPress translations.",
	"web_accessible_resources": [
		{
			"resources": [
				"js/wpgpt-checks.js",
				"js/wpgpt-all-page-warnings.js",
				"js/wpgpt-settings.js",
				"js/wpgpt-functions.js",
				"js/wpgpt-history.js",
				"js/wpgpt-bulk-consistency.js",
				"img/warning.png",
				"img/notice.png"
			],
			"matches": [
				"https://translate.wordpress.org/*"
			]
		}
	],
	"content_scripts": [
		{
			"matches": [
				"https://translate.wordpress.org/*"
			],
			"js": [
				"js/init.js",
				"js/wpgpt-functions.js",
				"js/wpgpt-consistency.js"
			],
			"css": [
				"css/wpgpt-style.css",
				"css/wpgpt-all-page-warnings.css"
			]
		}
	],
	"options_ui": {
		"page": "wpgpt-settings.html",
		"open_in_tab": false
	},
	"icons": {
		"16": "img/icon-16.png",
		"48": "img/icon-48.png",
		"128": "img/icon-128.png"
	}
}
